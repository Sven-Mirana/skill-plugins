{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sublation/agent-wakeup-policy-v1.json",
  "title": "Skill Sublation Agent Wakeup Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_source",
    "window_policy",
    "retry_policy",
    "default_policy",
    "registered_adapters",
    "pending_host_installs",
    "seat_policies"
  ],
  "properties": {
    "schema_version": {"const": "skill-sublation.agent-wakeup-policy.v1"},
    "binding_source": {"const": "project_local_panel_config"},
    "window_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_state",
        "requires_explicit_user_arm",
        "maximum_duration_seconds",
        "maximum_quiet_cycles",
        "maximum_wakes",
        "drain_on_any_limit",
        "close_requires_no_pending_intents",
        "close_requires_no_active_lease"
      ],
      "properties": {
        "default_state": {"const": "closed"},
        "requires_explicit_user_arm": {"const": true},
        "maximum_duration_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "maximum_quiet_cycles": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maximum_wakes": {"type": "integer", "minimum": 1, "maximum": 1000},
        "drain_on_any_limit": {"const": true},
        "close_requires_no_pending_intents": {"const": true},
        "close_requires_no_active_lease": {"const": true}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backoff_seconds", "max_attempts", "terminal_outcome"],
      "properties": {
        "backoff_seconds": {
          "type": "array",
          "prefixItems": [
            {"const": 60},
            {"const": 180},
            {"const": 600}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "max_attempts": {"const": 4},
        "terminal_outcome": {"const": "terminal_hold"}
      }
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "cooldown_seconds",
        "hourly_limit",
        "timeout_seconds",
        "escalation_seat_id",
        "max_messages_per_wake",
        "silent_when_idle"
      ],
      "properties": {
        "enabled": {"const": false},
        "mode": {"const": "queue_only"},
        "cooldown_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "hourly_limit": {"type": "integer", "minimum": 1, "maximum": 60},
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
        "escalation_seat_id": {"const": "user"},
        "max_messages_per_wake": {"const": 1},
        "silent_when_idle": {"const": true}
      }
    },
    "registered_adapters": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/adapter"}
    },
    "pending_host_installs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat_id", "adapter_id", "kind", "status"],
        "properties": {
          "seat_id": {"$ref": "#/$defs/opaque_id"},
          "adapter_id": {"$ref": "#/$defs/opaque_id"},
          "kind": {"enum": ["watcher_auto", "local_wakeup", "task_poll"]},
          "status": {"const": "pending_host_install"}
        }
      }
    },
    "seat_policies": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/seat_policy"}
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_sha256", "kind", "allowed_seat_ids"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/opaque_id"},
        "adapter_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["watcher_auto", "local_wakeup", "task_poll"]},
        "allowed_seat_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/opaque_id"}
        }
      }
    },
    "seat_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seat_id",
        "enabled",
        "mode",
        "adapter_id",
        "cooldown_seconds",
        "hourly_limit",
        "timeout_seconds",
        "escalation_seat_id",
        "max_messages_per_wake",
        "silent_when_idle"
      ],
      "properties": {
        "seat_id": {"$ref": "#/$defs/opaque_id"},
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["queue_only", "intent_only"]},
        "adapter_id": {
          "oneOf": [
            {"$ref": "#/$defs/opaque_id"},
            {"type": "null"}
          ]
        },
        "cooldown_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "hourly_limit": {"type": "integer", "minimum": 1, "maximum": 60},
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
        "escalation_seat_id": {"const": "user"},
        "max_messages_per_wake": {"const": 1},
        "silent_when_idle": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {
              "mode": {"const": "intent_only"},
              "adapter_id": {"$ref": "#/$defs/opaque_id"}
            }
          },
          "else": {
            "properties": {
              "mode": {"const": "queue_only"},
              "adapter_id": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
