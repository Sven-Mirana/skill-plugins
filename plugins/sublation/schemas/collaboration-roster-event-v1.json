{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sublation/collaboration-roster-event-v1.json",
  "title": "Skill Sublation Collaboration Roster Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "actor",
    "action",
    "seat_id",
    "reason",
    "previous_revision",
    "revision",
    "before_sha256",
    "after_sha256",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "skill-sublation.collaboration-roster-event.v1"},
    "event_id": {"$ref": "#/$defs/opaque_id"},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"const": "user"},
    "action": {"enum": ["initialize", "add", "update", "hide", "show", "retire", "restore"]},
    "seat_id": {"$ref": "#/$defs/seat_id"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\n\\r]*$"},
    "previous_revision": {"type": ["integer", "null"], "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "before_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "after_sha256": {"$ref": "#/$defs/sha256"},
    "previous_event_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "seat_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
  }
}
