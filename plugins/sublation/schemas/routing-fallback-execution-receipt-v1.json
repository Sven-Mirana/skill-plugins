{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sublation/routing-fallback-execution-receipt-v1.json",
  "title": "Skill Sublation Host Fallback Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "host_adapter_id",
    "host_adapter_sha256",
    "index_sha256",
    "case_id_set_sha256",
    "fallback_case_id_set_sha256",
    "fallback_case_count",
    "fallback_requested_count",
    "fallback_executed_count",
    "baseline_outcome_recorded_count",
    "cases",
    "performed_at",
    "execution_verified",
    "legacy_catalog_unchanged"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-sublation.routing-fallback-execution-receipt.v1"
    },
    "candidate_id": {"type": "string", "minLength": 1},
    "host_adapter_id": {"$ref": "#/$defs/canonical_opaque_id"},
    "host_adapter_sha256": {"$ref": "#/$defs/sha256"},
    "index_sha256": {"$ref": "#/$defs/sha256"},
    "case_id_set_sha256": {"$ref": "#/$defs/sha256"},
    "fallback_case_id_set_sha256": {"$ref": "#/$defs/sha256"},
    "fallback_case_count": {"$ref": "#/$defs/positive_integer"},
    "fallback_requested_count": {"$ref": "#/$defs/positive_integer"},
    "fallback_executed_count": {"$ref": "#/$defs/positive_integer"},
    "baseline_outcome_recorded_count": {"$ref": "#/$defs/positive_integer"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fallback_case"}
    },
    "performed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "execution_verified": {"const": true},
    "legacy_catalog_unchanged": {"const": true}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "canonical_opaque_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "positive_integer": {"type": "integer", "minimum": 1},
    "fallback_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "router_decision",
        "baseline_selection_id",
        "outcome"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/opaque_id"},
        "router_decision": {"const": "fallback"},
        "baseline_selection_id": {"$ref": "#/$defs/opaque_id"},
        "outcome": {"const": "completed"}
      }
    }
  }
}
